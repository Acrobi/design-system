{
  "name": "@acrobi/design-system",
  "version": "1.0.0",
  "description": "The official design system for Acrobi applications - complete meta-package",
  "author": "Brian Porter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Acrobi/design-system",
    "directory": "packages/design-system"
  },
  "keywords": [
    "acrobi",
    "design-system",
    "react",
    "components",
    "ui",
    "design-tokens",
    "theming"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@acrobi/design-tokens": "workspace:^",
    "@acrobi/design-primitives": "workspace:^",
    "@acrobi/design-icons": "workspace:^"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/react": "^19.1.2",
    "rollup": "^4.22.4",
    "rollup-plugin-dts": "^6.1.1",
    "typescript": "^5.9.2"
  }
}
